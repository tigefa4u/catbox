{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catbox",
  "main": "src/index.ts",
  // Latest date supported by the installed workerd runtime (1.20261023.1).
  // Bump to 2026-10-31 once the runtime catches up.
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Image replies are immutable and randomly keyed, so Cloudflare can serve
  // them from the edge without running the Worker. Sharing entries across
  // versions keeps the cache warm through deploys; purge the cache if image
  // response headers ever change.
  "cache": {
    "enabled": true,
    "cross_version_cache": true
  },
  "assets": {
    "directory": "./public",
    // "/" is rendered by the Worker (theme-aware), everything else is static.
    "run_worker_first": ["/"]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "catbox-images"
    }
  ],
  // Approximate per-location limit for anonymous uploads. Add a WAF
  // rate-limiting rule at the edge if the service is abused.
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
