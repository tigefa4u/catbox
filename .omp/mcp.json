{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--channel=stable"
      ]
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "auth": {
        "type": "oauth",
        "credentialId": "mcp_oauth:profile:default:https://mcp.cloudflare.com/mcp",
        "tokenUrl": "https://mcp.cloudflare.com/token",
        "clientId": "ceM-HDkcXhYdTpLH",
        "resource": "https://mcp.cloudflare.com/mcp"
      },
      "oauth": {
        "clientId": "ceM-HDkcXhYdTpLH"
      }
    }
  }
}