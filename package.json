{
  "name": "catbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "catbox": "cli/catbox"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc --noEmit",
    "test:cli": "node --test cli/catbox.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  }
}
